    Left to right: the pinned order, the view mode, then settings. The two that
    affect the list come before the one that leaves it, and the one that is
    only sometimes shown is leftmost, so nothing moves when it appears or
    disappears.
-->
<!--
    All three are always in the bar rather than in an overflow menu: there is
    room for three icons on the narrowest supported phone, and an overflow menu
    would hide the two list controls.
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="AlwaysShowAction">
    <!-- Shown only when there is an order to change: HomeActivity hides it with
         fewer than two pinned connections rather than opening a sheet with
         nothing to drag. -->
    <item
        android:id="@+id/action_reorder"
        android:icon="@drawable/ic_low_priority"
        android:title="@string/home_reorder"
        android:visible="false"
        app:showAsAction="always" />
    <!-- The icon and the title show the mode being switched to; HomeActivity
         sets both. One item with two states rather than two items. -->
    <item
        android:id="@+id/action_view_mode"
        android:icon="@drawable/ic_view_list"
        android:title="@string/home_view_list"
        app:showAsAction="always" />
    <item
        android:id="@+id/action_settings"
        android:icon="@drawable/ic_settings"
        android:title="@string/home_settings"
        app:showAsAction="always" />
</menu>
