    One saved connection, as an icon on a home screen.

    Adaptive, like the app's own, so the launcher can mask it to its own shape.
    The foreground is inside the safe zone, so a launcher that draws the whole
    square shows the same picture.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_shortcut_foreground" />
    <monochrome android:drawable="@drawable/ic_shortcut_foreground" />
</adaptive-icon>
