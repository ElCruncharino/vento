<?xml version="1.0" encoding="utf-8"?>
<!--
    SPDX-FileCopyrightText: 2026 Patrick Gaskin
    SPDX-License-Identifier: GPL-3.0-or-later

    A BackendOption.Type.TEXT or INT, also used for the connection editor's own
    fields.

    An inline field rather than a row that opens a dialog, so the value is
    typed without a second window hiding the form it belongs to (as in the
    androidx preference screen this replaced).

    The only row not on a group's container: an outlined box has its own
    corners, and a container behind it would add a second set. RowGroups gives
    it no background and ends the group on either side of it.
-->
<com.google.android.material.textfield.TextInputLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/field"
    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true" />

</com.google.android.material.textfield.TextInputLayout>
