    One pinned connection in the reorder sheet: its name, its address, and the
    drag handle.

    Each row is its own container, the only place in this app where a run of
    rows is not one group. A group's row background depends on its position,
    which a drag changes, so the rows on either side of a swap would change
    corners mid-gesture. A row that can be picked up is drawn as a separate
    item.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_group_single"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?android:attr/textColorSecondary"
            android:visibility="gone" />

    </LinearLayout>

    <!--
        The drag handle. A long press anywhere on the row also picks it up, as
        in other reorderable lists; the handle makes dragging discoverable.
    -->
    <ImageView
        android:id="@+id/drag"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/home_reorder_drag"
        android:padding="12dp"
        android:src="@drawable/ic_drag"
        app:tint="?android:attr/textColorSecondary" />

</LinearLayout>
