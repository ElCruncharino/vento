    The body of a choice dialog: the described values, one under the other. A
    ScrollView because the backend defines the list and the screen size
    decides how much of it fits; an AlertDialog scrolls its message but not a
    custom view.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fadingEdgeLength="16dp"
    android:requiresFadingEdge="vertical">

    <LinearLayout
        android:id="@+id/items"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</ScrollView>
