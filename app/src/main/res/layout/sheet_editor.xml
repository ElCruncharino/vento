    The connection editor.

    A form rather than a panel, which is why it is a full-screen dialog and not
    a sheet: nothing in it takes effect until Save, leaving it with changes
    asks first, and a form with the keyboard open needs the whole window.

    The frame is a fixed heading, scrolling rows and a fixed footer: the
    heading says what is being edited, and Save and the pin are reachable
    without scrolling to the end of a backend's options. All rows, the
    record's own fields included, are drawn by PanelOptions, which does not
    distinguish the two halves of the form.
-->
<!-- Not overdraw: this is a dialog's content, and its colour is a different
     surface from the screen behind it. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainerLow"
    android:orientation="vertical"
    tools:ignore="Overdraw">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="?attr/actionBarSize"
        android:orientation="horizontal"
        android:paddingStart="@dimen/header_inset"
        android:paddingTop="@dimen/header_padding"
        android:paddingEnd="@dimen/header_inset_button"
        android:paddingBottom="@dimen/header_padding">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceTitleLarge" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/close"
            style="@style/Widget.RemoteDesktop.HeaderButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/panel_close"
            app:icon="@drawable/ic_close" />

    </LinearLayout>

    <com.google.android.material.divider.MaterialDivider
        style="@style/Widget.RemoteDesktop.PanelDivider" />

    <!--
        The only scrolling part. Zero height plus a weight, so it takes the
        space the heading and footer leave and no more, and a form taller than
        the window does not push the footer off screen.
    -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <!-- The connection's name and address. -->
            <LinearLayout
                android:id="@+id/fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:orientation="vertical" />

            <!--
                In place of user name and password fields. Credentials are
                entered when connecting, and the prompt that asks for them
                offers to save them, so the editor only clears them, and a form
                that cannot show a password is one less place to leak it.
            -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/credentials"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/editor_credentials_clear" />

            <TextView
                android:id="@+id/credentials_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/heading_inset"
                android:paddingEnd="@dimen/heading_inset"
                android:paddingBottom="8dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?android:attr/textColorSecondary" />

            <!--
                The backend picker, below the credentials: it comes last of the
                three because it is usually set once, and because everything
                under the heading below depends on it. Hidden in a build with
                one backend.
            -->
            <LinearLayout
                android:id="@+id/protocol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Styled like a settings screen's category heading, since the
                 same options are listed under it. -->
            <TextView
                android:id="@+id/options_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/heading_inset"
                android:paddingTop="@dimen/heading_padding_top"
                android:paddingEnd="@dimen/heading_inset"
                android:paddingBottom="@dimen/heading_padding_bottom"
                android:text="@string/editor_options"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorPrimary" />

            <!-- The backend's per-connection options and AppOptions, rendered by PanelOptions. -->
            <LinearLayout
                android:id="@+id/options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.divider.MaterialDivider
        style="@style/Widget.RemoteDesktop.PanelDivider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/delete"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_delete"
            android:textColor="?attr/colorError" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!--
            Adds the connection to the launcher's home screen. Next to the pin
            because both are about where the connection appears. Unlike the pin
            it is not a toggle: the launcher does not tell this app what is on
            the home screen, so the button can only request, and a toggle would
            show a state it cannot know.

            For the same reason it has no outline: on a toggle the outlined
            container fills in when on, so an outlined action would look like
            a switch that is always off.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_screen"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/editor_home_screen"
            app:icon="@drawable/ic_add_home" />

        <!--
            Pinned is a state rather than an action, so the control is a toggle
            that shows it, not a button that inverts it. Beside Save because it
            is the other thing the editor writes, although it is written
            immediately and Save's changes are not.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/pin"
            style="@style/Widget.Material3.Button.IconButton.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:checkable="true"
            app:icon="@drawable/ic_pin" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/editor_save" />

    </LinearLayout>

</LinearLayout>
