<?xml version="1.0" encoding="utf-8"?>
<!--
    SPDX-FileCopyrightText: 2026 Patrick Gaskin
    SPDX-License-Identifier: GPL-3.0-or-later

    One androidx preference, drawn as a row of a group: the same metrics as the
    hand-built rows in the panel and the editor, since the same option
    descriptions are drawn in both.

    No icon frame and no background. No room is reserved for an icon because
    the app never sets one, and the adapter sets the background, since only it
    knows the row's position in its group.

    The ids are androidx's own: title, summary and widget_frame are looked up
    by id.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:minHeight="@dimen/row_min_height"
    android:paddingStart="@dimen/row_padding"
    android:paddingEnd="@dimen/row_padding">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="@dimen/row_padding"
        android:paddingBottom="@dimen/row_padding">

        <TextView
            android:id="@android:id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <TextView
            android:id="@android:id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?android:attr/textColorSecondary" />

    </LinearLayout>

    <LinearLayout
        android:id="@android:id/widget_frame"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="end|center_vertical"
        android:orientation="vertical"
        android:paddingStart="@dimen/row_padding"
        android:paddingEnd="0dp" />

</LinearLayout>
