    SPDX-License-Identifier: GPL-3.0-or-later

    One fact about the connection: the label at the start, the value at the
    end. One line rather than value over label, since this is a sheet over the
    desktop rather than a full screen.

    Tighter than a touchable row: facts are only read, and are read together.
    The container around them groups them; a 56 dp touch-target height would
    make the list twice as tall as the controls above it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="true"
    android:orientation="horizontal"
    android:paddingStart="@dimen/row_padding"
    android:paddingTop="7dp"
    android:paddingEnd="@dimen/row_padding"
    android:paddingBottom="7dp">

    <TextView
        android:id="@+id/label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?android:attr/textColorSecondary" />

    <TextView
        android:id="@+id/value"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="end"
        android:maxLines="2"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

</LinearLayout>
