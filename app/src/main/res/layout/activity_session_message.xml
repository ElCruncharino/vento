    The session window's content when there is no session: a connection with
    no address, a backend this build does not have, a plugin whose constructor
    threw, or one that has to be set up before it can connect. A message, and
    sometimes one action.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/header_inset"
    android:paddingTop="48dp"
    android:paddingEnd="@dimen/header_inset"
    android:paddingBottom="@dimen/header_inset">

    <TextView
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Borderless, so it does not look like a second panel on an otherwise
         empty screen. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/action"
        style="?attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
