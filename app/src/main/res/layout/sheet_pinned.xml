<?xml version="1.0" encoding="utf-8"?>
<!--
    SPDX-FileCopyrightText: 2026 Patrick Gaskin
    SPDX-License-Identifier: GPL-3.0-or-later

    The pinned connections, in their order at the top of the home screen, for
    reordering by drag.

    A separate sheet rather than a mode over the list, because on the list a
    press already opens a connection and a long press edits it. Only the pinned
    connections and only their names are shown: reordering is about which
    comes first, so desktop previews would only take up space.

    Wrap content, not a weight: the sheet is as tall as the pinned rows, and the
    list scrolls only once they no longer fit on screen.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/group_spacing">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="?attr/actionBarSize"
        android:orientation="horizontal"
        android:paddingStart="@dimen/header_inset"
        android:paddingTop="@dimen/header_padding"
        android:paddingEnd="@dimen/header_inset_button"
        android:paddingBottom="@dimen/header_padding">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/home_reorder"
            android:textAppearance="?attr/textAppearanceTitleLarge" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/close"
            style="@style/Widget.RemoteDesktop.HeaderButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/panel_close"
            app:icon="@drawable/ic_close" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false" />

</LinearLayout>
