    One connection: the desktop as it last looked, its name, its address.

    Filled rather than outlined: a Material 3 card is separated from the
    background by its container colour, not by an outline. The preview area is
    one surface tone below the card, so a card with no thumbnail yet still
    shows an empty picture area rather than a flat block.

    The card uses the colour and corner radius of a group of rows, so a
    connection here and an option on a settings screen have the same shape.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card"
    style="@style/Widget.Material3.CardView.Filled"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/card_margin"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="?attr/colorSurfaceBright"
    app:cardCornerRadius="@dimen/group_radius"
    app:contentPadding="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!--
            A fixed ratio rather than the desktop's own: see PreviewImageView.
            Cropped to fill, so a preview shows a recognisable part of the
            desktop rather than a small letterboxed image.
        -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <net.pgaskin.remotedesktop.PreviewImageView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorSurfaceContainerHigh"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <!--
                The connection's backend. Over the preview rather than beside
                the address, because it is a label rather than a line of text to
                read: the backends behave differently enough that it is worth
                seeing at a glance.
            -->
            <TextView
                android:id="@+id/badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="@dimen/card_margin"
                android:background="@drawable/bg_badge"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="#e8ffffff" />

            <!--
                Shown while a session is running, the only thing on this card
                that is not a property of the saved connection. HomeActivity
                tints it with the accent colour rather than the scrim the other
                two use, since the accent is the only colour on this screen that
                means something is live.
            -->
            <TextView
                android:id="@+id/connected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="@dimen/card_margin"
                android:background="@drawable/bg_badge"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:visibility="gone" />

            <!--
                Pinned, at the other end of the band from the backend badge. The
                same scrim as the badge, for the same reason: the preview behind
                it may be any colour.
            -->
            <ImageView
                android:id="@+id/pin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="@dimen/card_margin"
                android:background="@drawable/bg_badge"
                android:contentDescription="@string/home_pinned"
                android:padding="3dp"
                android:src="@drawable/ic_pin"
                app:tint="#e8ffffff"
                android:visibility="gone" />

        </FrameLayout>

        <!--
            The inset is the text block's padding, not margins on the two
            labels. A connection with no name puts its address in the title and
            hides the subtitle, and a bottom margin on the subtitle would be
            hidden with it, leaving the title against the bottom of the card.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?android:attr/textColorSecondary" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
