    SPDX-License-Identifier: GPL-3.0-or-later

    A BackendOption.Type.BOOL. The whole row is the touch target and the switch
    only shows the state: a full-width row is easier to hit than a switch in a
    panel used one-handed over a desktop.

    RowGroups sets the group background, which includes the ripple.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/row_min_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/row_padding"
    android:paddingEnd="@dimen/row_padding">

    <TextView
        android:id="@+id/label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="?attr/textAppearanceBodyLarge" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:clickable="false"
        android:focusable="false" />

</LinearLayout>
