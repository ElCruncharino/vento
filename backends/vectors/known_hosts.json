    { "pins": { "host:3389": "AB:CD:EF" }, "address": "host:3389", "fingerprint": "00:11", "verdict": "ask", "identity": "changed", "matching_address": "" },
    { "pins": { "host:3389": "AB:CD:EF" }, "address": "10.0.0.5:3389", "fingerprint": "AB:CD:EF", "verdict": "ask", "identity": "matches_another", "matching_address": "host:3389" },
    { "pins": { "host:3389": "AB:CD:EF" }, "address": "10.0.0.5:3389", "fingerprint": "00:11", "verdict": "ask", "identity": "new", "matching_address": "" },
