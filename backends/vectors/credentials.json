{
  "about": [
    "What a credentials prompt's answer comes to, for every client that has one. Read by",
    "the Rust tests and by the Java ones, which is the point: a rule written twice is two",
    "rules the day one of them is changed, and these are the cases both must agree on.",
    "split_domain: a typed user name as {domain, user}. rdp_identity: an RDP prompt's",
    "answer against the session's own domain and user (already split); answer_domain is",
    "a domain given beside the name, which only the Linux client's --domain has, so the",
    "Java side reads a vector with one as not its to check. fill_user: any other",
    "backend's answer, where an empty user name is the session's. A name is read trimmed",
    "everywhere, so one that is only spaces is an empty one."
  ],
  "split_domain": [
    { "typed": "CORP\\alice", "domain": "CORP", "user": "alice" },
    { "typed": "alice@corp.example", "domain": "corp.example", "user": "alice" },
    { "typed": " alice ", "domain": "", "user": "alice" },
    { "typed": "", "domain": "", "user": "" },
    { "typed": "@odd", "domain": "", "user": "@odd" },
    { "typed": "alice@", "domain": "", "user": "alice" },
    { "typed": "x@y@z", "domain": "y@z", "user": "x" },
    { "typed": "a\\b\\c", "domain": "a", "user": "b\\c" },
    { "typed": "CORP\\alice@x", "domain": "CORP", "user": "alice@x" },
    { "typed": ".\\alice", "domain": ".", "user": "alice" },
    { "typed": "\\alice", "domain": "", "user": "alice" },
    { "typed": "DOM\\", "domain": "DOM", "user": "" }
  ],
  "rdp_identity": [
    { "session_domain": "CORP", "session_user": "proto", "answer_user": "", "domain": "CORP", "user": "proto" },
    { "session_domain": "CORP", "session_user": "proto", "answer_user": "   ", "domain": "CORP", "user": "proto" },
    { "session_domain": "CORP", "session_user": "proto", "answer_user": "proto", "domain": "CORP", "user": "proto" },
    { "session_domain": "CORP", "session_user": "proto", "answer_user": "alice", "domain": "CORP", "user": "alice" },
    { "session_domain": "CORP", "session_user": "proto", "answer_user": " alice ", "domain": "CORP", "user": "alice" },
    { "session_domain": "CORP", "session_user": "proto", "answer_user": "LAB\\alice", "domain": "LAB", "user": "alice" },
    { "session_domain": "CORP", "session_user": "proto", "answer_user": "alice@lab.example", "domain": "lab.example", "user": "alice" },
    { "session_domain": "CORP", "session_user": "proto", "answer_user": ".\\alice", "domain": ".", "user": "alice" },
    { "session_domain": "", "session_user": "proto", "answer_user": "alice", "domain": "", "user": "alice" },
    { "session_domain": "", "session_user": "", "answer_user": "", "domain": "", "user": "" },
    { "session_domain": "CORP", "session_user": "proto", "answer_user": "alice", "answer_domain": "LAB", "domain": "LAB", "user": "alice" },
    { "session_domain": "CORP", "session_user": "proto", "answer_user": "", "answer_domain": "LAB", "domain": "CORP", "user": "proto" }
  ],
  "fill_user": [
    { "session_user": "proto", "answer_user": "", "user": "proto" },
    { "session_user": "proto", "answer_user": "alice", "user": "alice" },
    { "session_user": "", "answer_user": "", "user": "" },
    { "session_user": "proto", "answer_user": " ", "user": "proto" },
    { "session_user": "proto", "answer_user": " alice ", "user": "alice" }
  ]
}
