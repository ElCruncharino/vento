From 5bd995bb663577b8e34e97c8815608f378dede42 Mon Sep 17 00:00:00 2001
From: "Claude Opus 5.5" <noreply@anthropic.com>
Date: Thu, 15 Oct 2026 01:41:28 -0400
Subject: [PATCH 7/7] rfb: H.264 is decoded into the framebuffer's own pixel
 format

The libav context had swscale write AV_PIX_FMT_RGB32, a native-endian
word with red at bit 16, and handed the result to imageRect() as if it
were already in the framebuffer's format. That holds for the viewer's
own framebuffer on a little-endian machine, which is BGRX in memory,
and for nothing else: a client whose framebuffer is RGBX got red and
blue swapped, and anything less like XRGB got worse. The TODO beside
the format already wondered whether the assumption held.

The output format is now chosen from the framebuffer's pixel format,
the way JpegDecompressor chooses libjpeg's: one of the four 32-bit
byte orders swscale writes directly when the framebuffer is one of
them, and BGRX converted through imageRect(pf, ...) otherwise. The
frame is reallocated when that format changes. The viewer's own
framebuffer still gets BGRA, so it decodes exactly as before.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/common/rfb/H264LibavDecoderContext.cxx b/common/rfb/H264LibavDecoderContext.cxx
index 70dcc305..46dde298 100644
--- a/common/rfb/H264LibavDecoderContext.cxx
+++ b/common/rfb/H264LibavDecoderContext.cxx
@@ -43,6 +43,31 @@ extern "C" {
 
 using namespace rfb;
 
+//
+// Formats that swscale can write directly, named by their byte order
+// in memory
+//
+
+static const PixelFormat pfRGBX(32, 24, false, true, 255, 255, 255, 0, 8, 16);
+static const PixelFormat pfBGRX(32, 24, false, true, 255, 255, 255, 16, 8, 0);
+static const PixelFormat pfXRGB(32, 24, false, true, 255, 255, 255, 8, 16, 24);
+static const PixelFormat pfXBGR(32, 24, false, true, 255, 255, 255, 24, 16, 8);
+
+// The swscale format whose bytes are the given pixel format's, or
+// AV_PIX_FMT_NONE if there is none and the frame has to be converted
+static AVPixelFormat swsFormatFor(const PixelFormat& pf)
+{
+  if (pfRGBX == pf)
+    return AV_PIX_FMT_RGBA;
+  if (pfBGRX == pf)
+    return AV_PIX_FMT_BGRA;
+  if (pfXRGB == pf)
+    return AV_PIX_FMT_ARGB;
+  if (pfXBGR == pf)
+    return AV_PIX_FMT_ABGR;
+  return AV_PIX_FMT_NONE;
+}
+
 H264LibavDecoderContext::H264LibavDecoderContext(const core::Rect& r)
   : H264DecoderContext(r)
 {
@@ -188,8 +213,19 @@ void H264LibavDecoderContext::decode(const uint8_t* h264_in_buffer,
   if ((frame->width < rect.width()) || (frame->height < rect.height()))
     return;
 
+  // The frame is written in the pixel buffer's own format when swscale
+  // has one with the same bytes, and in BGRX to be converted otherwise.
+  // A fixed AV_PIX_FMT_RGB32 was only right for a buffer of native-endian
+  // words with red at bit 16 (BGRX in memory on a little-endian machine);
+  // one in RGBX, say, got its red and blue swapped.
+  const PixelFormat& pf = pb->getPF();
+  AVPixelFormat dstFormat = swsFormatFor(pf);
+  bool convert = dstFormat == AV_PIX_FMT_NONE;
+  if (convert)
+    dstFormat = AV_PIX_FMT_BGRA;
+
   sws = sws_getCachedContext(sws, frame->width, frame->height, avctx->pix_fmt,
-                             frame->width, frame->height, AV_PIX_FMT_RGB32,
+                             frame->width, frame->height, dstFormat,
                              SWS_POINT, nullptr, nullptr, nullptr);
 
   int inFull, outFull, brightness, contrast, saturation;
@@ -207,15 +243,15 @@ void H264LibavDecoderContext::decode(const uint8_t* h264_in_buffer,
   sws_setColorspaceDetails(sws, inTable, inFull, outTable, outFull, brightness,
       contrast, saturation);
 
-  if (rgbFrame && (rgbFrame->width != frame->width || rgbFrame->height != frame->height)) {
+  if (rgbFrame && (rgbFrame->width != frame->width ||
+                   rgbFrame->height != frame->height ||
+                   rgbFrame->format != dstFormat)) {
     av_frame_free(&rgbFrame);
-
   }
 
   if (!rgbFrame) {
     rgbFrame = av_frame_alloc();
-    // TODO: Can we really assume that the pixel format will always be RGB32?
-    rgbFrame->format = AV_PIX_FMT_RGB32;
+    rgbFrame->format = dstFormat;
     rgbFrame->width = frame->width;
     rgbFrame->height = frame->height;
     av_frame_get_buffer(rgbFrame, 0);
@@ -224,5 +260,8 @@ void H264LibavDecoderContext::decode(const uint8_t* h264_in_buffer,
   sws_scale(sws, frame->data, frame->linesize, 0, frame->height, rgbFrame->data,
             rgbFrame->linesize);
 
-  pb->imageRect(rect, rgbFrame->data[0], rgbFrame->linesize[0] / 4);
+  if (convert)
+    pb->imageRect(pfBGRX, rect, rgbFrame->data[0], rgbFrame->linesize[0] / 4);
+  else
+    pb->imageRect(rect, rgbFrame->data[0], rgbFrame->linesize[0] / 4);
 }
