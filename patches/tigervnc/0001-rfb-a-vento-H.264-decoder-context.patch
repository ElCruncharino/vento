From f26e224a6512a2f22a757d5f74089d24f8b20418 Mon Sep 17 00:00:00 2001
From: "Claude Opus 5.5" <noreply@anthropic.com>
Date: Fri, 16 Oct 2026 16:11:35 -0400
Subject: [PATCH 1/6] rfb: a vento H.264 decoder context

The context class itself is in the embedding build's shim, where a
build's own code belongs: it hands each rectangle to the decoders of
the program TigerVNC is part of (on Android the platform's MediaCodec,
on a desktop that program's own FFmpeg). This is only the branch that
selects it, beside the two upstream has.

diff --git a/common/rfb/H264DecoderContext.cxx b/common/rfb/H264DecoderContext.cxx
index d9acb944..3578dcc9 100644
--- a/common/rfb/H264DecoderContext.cxx
+++ b/common/rfb/H264DecoderContext.cxx
@@ -30,6 +30,9 @@
 #ifdef WIN32
 #include <rfb/H264WinDecoderContext.h>
 #endif
+#ifdef H264_VENTO
+#include <H264VentoDecoderContext.h>
+#endif
 
 using namespace rfb;
 
@@ -41,6 +44,9 @@ H264DecoderContext *H264DecoderContext::createContext(const core::Rect &r)
 #ifdef WIN32
   return new H264WinDecoderContext(r);
 #endif
+#ifdef H264_VENTO
+  return new H264VentoDecoderContext(r);
+#endif
 }
 
 H264DecoderContext::~H264DecoderContext()
