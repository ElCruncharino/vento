diff --git a/channels/rdp2tcp/client/rdp2tcp_main.c b/channels/rdp2tcp/client/rdp2tcp_main.c
index 7f5306bd9..62dd111d7 100644
--- a/channels/rdp2tcp/client/rdp2tcp_main.c
