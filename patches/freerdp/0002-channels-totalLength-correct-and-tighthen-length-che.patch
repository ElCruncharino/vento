 	if (dataFlags & CHANNEL_FLAG_LAST)
@@ -997,6 +999,7 @@ static UINT encomsp_virtual_channel_event_data_received(encomspPlugin* encomsp,
 			return ERROR_INVALID_DATA;
 		}
 
+		encomsp->totalLength = 0;
