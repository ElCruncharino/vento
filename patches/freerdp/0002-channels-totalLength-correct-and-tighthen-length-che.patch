 } Plugin;
 
 static int init_external_addin(Plugin* plugin)
@@ -192,6 +193,7 @@ static void dataReceived(Plugin* plugin, void* pData, UINT32 dataLength, UINT32
 
 	if (dataFlags & CHANNEL_FLAG_FIRST)
