<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Everything this add-on stores is a third-party binary, acquired on the
        phone it is for. Backing it up would send it off the device by an
        unintended route, and restoring it could put a build for one ABI on
        another, which the hash check refuses; so a backup could only do the
        part that is not wanted.
    -->
    <!-- No icon, because there is no launcher entry to put one on. -->
    <application
        android:label="@string/app_name"
        tools:ignore="MissingApplicationIcon"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/backup_rules"
        android:theme="@style/Theme.Plugin">

        <!--
            Read by the app: where a build of this package for the app's
            version is, and the key the file there is signed with. Both values
            are set in this module's build.gradle, which explains them.

            Meta-data because the app reads this from a package whose dex it
            has refused to load: the app only reads it because this package
            was built for another version of the app.
        -->
        <meta-data
            android:name="net.pgaskin.remotedesktop.plugin.updateUrl"
            android:value="${updateUrl}" />
        <meta-data
            android:name="net.pgaskin.remotedesktop.plugin.updateSignature"
            android:value="${updateSignature}" />

        <!--
            No launcher filter: this is reached from the app and from nowhere
            else. Exported for that, since the app is another package.
        -->
        <activity
            android:name="net.pgaskin.remotedesktop.realvnc.RealVncSetupActivity"
            android:exported="true"
            android:label="@string/setup_title">
            <intent-filter>
                <action android:name="net.pgaskin.remotedesktop.action.SETUP_PLUGIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            The only way data leaves this add-on's uid. The authority
            carries the applicationId so that a debug build and a release one
            can be installed side by side.
        -->
        <provider
            android:name="net.pgaskin.remotedesktop.realvnc.RealVncLibraryProvider"
            android:authorities="${applicationId}.libraries"
            android:exported="true"
            android:grantUriPermissions="false"
            tools:ignore="ExportedContentProvider" />

    </application>

</manifest>
