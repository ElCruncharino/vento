<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        An add-on generally downloads something, since add-ons exist to hold
        what the app's build cannot include. `plugins/rustdesk` removes this.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Not for deciding when to fetch, but for telling the user which of two
        failures happened. An app denied network access cannot resolve any
        host, and "unable to resolve host" would blame DNS for a problem
        unrelated to DNS.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />


    <application>

        <!--
            Never bound. It exists so that the app's <queries> entry for this
            action matches the package, which is both how an add-on is found and
            what makes it visible to everything else the app asks about it.

            Exported because package visibility is decided by AppsFilter, which
            only considers components another package can reach: a filter on an
            unexported component matches nothing and the add-on stays invisible.
            It returns null from a bind and stops itself if started, so being
            reachable costs nothing.
        -->
        <service
            android:name=".PluginService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="net.pgaskin.remotedesktop.action.BACKEND_PLUGIN" />
            </intent-filter>
        </service>

    </application>

</manifest>
