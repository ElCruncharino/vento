<?xml version="1.0" encoding="utf-8"?>
<!--
    The same pair as the RealVNC add-on's: `allowBackup="false"` stops cloud
    backup and nothing else, and device-to-device transfer is a separate
    mechanism that copies the whole data directory unless it has its own rules.

    This add-on downloads nothing, so the excluded directory is empty for now.
    The rule is kept anyway, because if the add-on ever gains files to keep, the
    default would copy them to the next phone.
-->
<data-extraction-rules>
    <device-transfer>
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
