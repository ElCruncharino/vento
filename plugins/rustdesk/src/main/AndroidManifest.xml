<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Both of these come from `:plugins`, where an add-on that downloads
        something needs them. This one downloads nothing: its backend runs in
        the app's process and uses the app's network permission, and requesting
        an unused permission would misrepresent the package.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!--
        Nothing is stored or downloaded here: this add-on is the backend and its
        library, and it is a separate package only because of what it would put
        on the app's listing. So there is no activity, no provider, and no data
        worth backing up.

        The marker service the app discovers it by comes from `:plugins`, along
        with the two permissions that a downloading add-on needs and this one
        removes.
    -->
    <!-- No icon, because there is no launcher entry. -->
    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/backup_rules"
        tools:ignore="MissingApplicationIcon">

        <!--
            Read by the app: where to find a build of this add-on for the app's
            version, and the certificate that file is signed with. Both values,
            and the reasons for them, are in this module's build.gradle.

            Meta-data because the app reads it from a package whose dex it has
            refused to load: the app only needs it when this package was built
            for another version of the app.
        -->
        <meta-data
            android:name="net.pgaskin.remotedesktop.plugin.updateUrl"
            android:value="${updateUrl}" />
        <meta-data
            android:name="net.pgaskin.remotedesktop.plugin.updateSignature"
            android:value="${updateSignature}" />

    </application>

</manifest>
